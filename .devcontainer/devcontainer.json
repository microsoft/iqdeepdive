{
  "name": "Microsoft IQ Deep Dive with Python",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/azure/azure-dev/azd:1": {},
    "ghcr.io/devcontainers-extra/features/uv:1": {}
  },
  "postCreateCommand": "uv sync --locked --all-groups && uv pip install --python .venv/bin/python -r notebooks/requirements.txt && for d in src/*/; do if [ -f \"$d/uv.lock\" ]; then uv sync --project \"$d\" --locked || exit 1; fi; done",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "remote.autoForwardPorts": false
      },
      "extensions": [
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-bicep",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "vscode"
}
